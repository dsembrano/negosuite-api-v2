# Reference only. Supply real values through your deployment secret store.
# Required for authentication/database operations:
ConnectionString__negosuite=server=MYSQL_HOST;port=3306;database=DATABASE;user=USER;password=REPLACE_ME
Jwt__Key=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
Jwt__Issuer=REPLACE_ME
Jwt__Audience=REPLACE_ME
AppUrl=https://V2_FRONTEND_HOST

# Required for APK downloads (previously compiled into AppVersionController):
Storage__AccessKey=REPLACE_ME
Storage__SecretKey=REPLACE_ME
Storage__Region=REPLACE_ME
Storage__Bucket=REPLACE_ME

# Required when the corresponding integration is enabled:
Smtp__Host=REPLACE_ME
Smtp__Port=587
Smtp__Username=REPLACE_ME
Smtp__Password=REPLACE_ME
Smtp__FromEmail=REPLACE_ME
Metabase__DashboardKey=REPLACE_ME
DeepSeek__ApiKey=REPLACE_ME

# Configure only actual ingress proxy IPs or narrowly scoped ingress networks.
# ReverseProxy__KnownProxies__0=192.0.2.10
# ReverseProxy__KnownNetworks__0=192.0.2.0/24
